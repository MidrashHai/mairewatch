<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MaireWatch™ — Veille Dr Sylvestre Emmou</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f4f0; color: #1a1a18; min-height: 100vh; }
  .wrap { max-width: 680px; margin: 0 auto; padding: 1.5rem 1rem; }

  /* LOGIN */
  .login-wrap { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1rem; }
  .login-box { background: #fff; border: 0.5px solid #d3d1c7; border-radius: 12px; padding: 2rem; width: 100%; max-width: 360px; }
  .login-logo { text-align: center; margin-bottom: 1.5rem; }
  .login-logo h1 { font-size: 20px; font-weight: 500; margin-bottom: 4px; }
  .login-logo p { font-size: 12px; color: #888780; }
  .field { margin-bottom: 12px; }
  .field label { display: block; font-size: 12px; color: #888780; margin-bottom: 6px; }
  .field input { width: 100%; padding: 9px 12px; font-size: 13px; border: 0.5px solid #b4b2a9; border-radius: 8px; background: #fff; color: #1a1a18; outline: none; }
  .field input:focus { border-color: #888780; }
  .err { font-size: 12px; color: #a32d2d; margin-bottom: 10px; }
  .btn-primary { width: 100%; padding: 10px; font-size: 13px; font-weight: 500; cursor: pointer; border-radius: 8px; border: 0.5px solid #b4b2a9; background: #fff; color: #1a1a18; transition: background 0.15s; }
  .btn-primary:hover { background: #f1efe8; }
  .login-footer { font-size: 11px; color: #888780; text-align: center; margin-top: 16px; }

  /* DASHBOARD */
  .hidden { display: none; }
  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
  .header-title h2 { font-size: 17px; font-weight: 500; margin-bottom: 2px; }
  .header-title p { font-size: 11px; color: #888780; }
  .badge-active { font-size: 12px; font-weight: 500; padding: 5px 12px; border-radius: 8px; background: #eaf3de; color: #3b6d11; }
  .btn-logout { font-size: 11px; padding: 5px 10px; cursor: pointer; border-radius: 8px; border: 0.5px solid #d3d1c7; background: #fff; color: #888780; margin-left: 8px; }
  .stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 1.25rem; }
  .stat { border-radius: 8px; padding: 0.75rem 1rem; text-align: center; }
  .stat .val { font-size: 24px; font-weight: 500; }
  .stat .lbl { font-size: 11px; margin-top: 2px; opacity: 0.8; }
  .card { background: #fff; border: 0.5px solid #d3d1c7; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .filters-row { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .search-input { flex: 1; min-width: 160px; padding: 7px 12px; font-size: 13px; border: 0.5px solid #b4b2a9; border-radius: 8px; background: #fff; color: #1a1a18; outline: none; }
  .btn-sm { padding: 7px 14px; font-size: 12px; cursor: pointer; border-radius: 8px; border: 0.5px solid #b4b2a9; background: #fff; color: #888780; }
  .pills { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 0; }
  .pill { padding: 4px 12px; border-radius: 8px; font-size: 12px; cursor: pointer; border: 0.5px solid #d3d1c7; background: #fff; color: #888780; user-select: none; }
  .pill.active-critique { border: 2px solid #a32d2d; background: #fcebeb; color: #a32d2d; font-weight: 500; }
  .pill.active-modere { border: 2px solid #ba7517; background: #faeeda; color: #ba7517; font-weight: 500; }
  .pill.active-faible { border: 2px solid #3b6d11; background: #eaf3de; color: #3b6d11; font-weight: 500; }
  .pill.active-tous { border: 2px solid #888780; font-weight: 500; }
  .sources-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 1rem; }
  .source-pill { padding: 4px 10px; border-radius: 8px; font-size: 11px; cursor: pointer; border: 0.5px solid #d3d1c7; background: #fff; color: #888780; user-select: none; }
  .source-pill.active { border: 2px solid #185fa5; background: #e6f1fb; color: #185fa5; font-weight: 500; }
  .alerte { background: #fff; border: 0.5px solid #d3d1c7; border-radius: 0 12px 12px 0; padding: 0.9rem 1.25rem; margin-bottom: 0.6rem; cursor: pointer; border-left-width: 4px; opacity: 1; transition: opacity 0.15s; }
  .alerte.lu { opacity: 0.8; }
  .alerte-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
  .alerte-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
  .dot-unread { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
  .alerte-date { font-size: 11px; color: #888780; }
  .alerte-titre { font-size: 13px; font-weight: 500; line-height: 1.4; flex: 1; padding-right: 10px; }
  .badge-niv { font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 8px; flex-shrink: 0; }
  .alerte-body { margin-top: 10px; padding-top: 10px; border-top: 0.5px solid #d3d1c7; display: none; }
  .alerte-body.open { display: block; }
  .extrait { background: #f1efe8; border-radius: 8px; padding: 0.75rem 1rem; font-size: 13px; line-height: 1.7; font-style: italic; margin-bottom: 10px; }
  .alerte-actions { display: flex; gap: 8px; }
  .btn-link { padding: 5px 14px; font-size: 12px; cursor: pointer; border-radius: 8px; border: 0.5px solid #b4b2a9; background: #fff; color: #1a1a18; text-decoration: none; display: inline-block; }
  .btn-source { padding: 5px 14px; font-size: 12px; border-radius: 8px; background: #f1efe8; color: #888780; }
  .empty { text-align: center; padding: 2rem; color: #888780; font-size: 13px; }
  .footer { font-size: 11px; color: #888780; text-align: center; margin-top: 1rem; }
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-wrap" id="login-screen">
  <div>
    <div class="login-box">
      <div class="login-logo">
        <h1>MaireWatch™</h1>
        <p>Système de veille nominative · CorreIA LLC</p>
      </div>
      <div class="field">
        <label>Identifiant</label>
        <input type="text" id="inp-user" placeholder="Identifiant de session" onkeydown="if(event.key==='Enter')doLogin()"/>
      </div>
      <div class="field">
        <label>Mot de passe</label>
        <input type="password" id="inp-pass" placeholder="••••••••••" onkeydown="if(event.key==='Enter')doLogin()"/>
      </div>
      <p class="err hidden" id="login-err">Identifiant ou mot de passe incorrect</p>
      <button class="btn-primary" onclick="doLogin()">Accéder au dashboard →</button>
    </div>
    <p class="login-footer">Accès réservé · Commune de Port-Bouët</p>
  </div>
</div>

<!-- DASHBOARD -->
<div class="hidden" id="dashboard-screen">
<div class="wrap">

  <div class="header">
    <div class="header-title">
      <h2>MaireWatch™</h2>
      <p>Dr Sylvestre Emmou · Maire de Port-Bouët · 7 sources actives</p>
    </div>
    <div style="display:flex;align-items:center">
      <span class="badge-active">Veille active</span>
      <button class="btn-logout" onclick="doLogout()">Déconnexion</button>
    </div>
  </div>

  <div class="stats">
    <div class="stat" style="background:#fcebeb"><div class="val" style="color:#a32d2d" id="stat-nonlus">0</div><div class="lbl" style="color:#a32d2d">Non lues</div></div>
    <div class="stat" style="background:#faeeda"><div class="val" style="color:#ba7517" id="stat-crit">0</div><div class="lbl" style="color:#ba7517">Critiques</div></div>
    <div class="stat" style="background:#eaf3de"><div class="val" style="color:#3b6d11" id="stat-today">0</div><div class="lbl" style="color:#3b6d11">Aujourd'hui</div></div>
  </div>

  <div class="card">
    <div class="filters-row">
      <input class="search-input" id="search" placeholder="Rechercher dans les alertes..." oninput="render()"/>
      <button class="btn-sm" onclick="marquerTousLus()">Tout marquer lu</button>
    </div>
    <div class="pills" id="pills-niveau">
      <div class="pill active-tous" data-niv="Tous" onclick="setNiveau(this)">Tous niveaux</div>
      <div class="pill" data-niv="critique" onclick="setNiveau(this)">Critique</div>
      <div class="pill" data-niv="modere" onclick="setNiveau(this)">Modéré</div>
      <div class="pill" data-niv="faible" onclick="setNiveau(this)">Faible</div>
    </div>
  </div>

  <div class="sources-row" id="sources-row"></div>
  <div id="alertes-list"></div>
  <p class="footer" id="footer-txt"></p>

</div>
</div>

<script>
const USER = "DrEmmou", PASS = "14Eloul5786";
const TODAY = "2026-09-08";
const SOURCES = ["Toutes","Abidjan.net","L'Infodrome","Connection Ivoirienne","InfoIvoire","Fratmat.info","RTI.info","Google Alerts"];
const NIVEAUX = {
  critique: { label:"Critique", bg:"#fcebeb", color:"#a32d2d", border:"#f09595" },
  modere:   { label:"Modéré",   bg:"#faeeda", color:"#ba7517", border:"#EF9F27" },
  faible:   { label:"Faible",   bg:"#eaf3de", color:"#3b6d11", border:"#97C459" }
};

let alertes = [
  { id:1, date:"2026-09-08", heure:"17:31", source:"L'Infodrome", niveau:"critique", titre:"Port-Bouët : Le Maire Emmou répond au Ministre-gouverneur et dénonce un « sale boulot »", extrait:"Le Maire de Port-Bouet, Dr Sylvestre Emmou a commenté la lettre du Ministre-Gouverneur Bacongo Cissé. La municipalité de Port-Bouet s'est dédouanée en jetant la faute sur le District.", url:"https://www.linfodrome.com/politique/123018-port-bouet-le-maire-emmou-repond-au-ministre-gouverneur-et-denonce-un-sale-boulot", lu:false },
  { id:2, date:"2026-09-07", heure:"09:14", source:"Google Alerts", niveau:"critique", titre:"Déguerpissements en Côte d'Ivoire : entre Sylvestre Emmou et Ibrahim Cissé Bacongo...", extrait:"...maire de Port-Bouët, qui se pose en protecteur des populations. Sylvestre Emmou a annoncé des mesures d'accompagnement pour les déguerpis.", url:"https://www.jeuneafrique.com", lu:false },
  { id:3, date:"2026-09-06", heure:"14:22", source:"Abidjan.net", niveau:"modere", titre:"Port-Bouët : Sylvestre Emmou annonce la découverte du corps sans vie d'un habitant", extrait:"Le maire de Port-Bouët, Emmou Sylvestre, n'a pas pu retenir ses larmes face à la désolation des populations sinistrées.", url:"https://news.abidjan.net", lu:true },
  { id:4, date:"2026-09-05", heure:"11:05", source:"Fratmat.info", niveau:"faible", titre:"Recettes fiscales : Sylvestre Emmou fait un don important aux Impôts", extrait:"Pour un meilleur recouvrement, Sylvestre Emmou fait un don aux Impôts en signe d'engagement citoyen.", url:"https://www.fratmat.info", lu:true },
  { id:5, date:"2026-09-04", heure:"08:47", source:"RTI.info", niveau:"faible", titre:"Inauguration des Agora Yopougon et Port-Bouët avant la CAN", extrait:"Sylvestre Emmou, Député-Maire de Port-Bouët, Son Excellence Monsieur Jean-Christophe Belliard, Ambassadeur de France en Côte d'Ivoire.", url:"https://rti.info", lu:true },
  { id:6, date:"2026-09-02", heure:"16:30", source:"Google Alerts", niveau:"modere", titre:"[Politique] Docteur Sylvestre Emmou, Député-Maire de Port-Bouet, nommé...", extrait:"Facebook — mention du Docteur Sylvestre Emmou dans un post politique ayant généré plus de 200 partages.", url:"https://facebook.com", lu:true }
];

let filtreNiveau = "Tous", filtreSource = "Toutes", selected = null;

function doLogin() {
  const u = document.getElementById("inp-user").value.trim();
  const p = document.getElementById("inp-pass").value.trim();
  const err = document.getElementById("login-err");
  if (!u || !p) { err.textContent = "Tous les champs sont requis"; err.classList.remove("hidden"); return; }
  if (u === USER && p === PASS) {
    document.getElementById("login-screen").classList.add("hidden");
    document.getElementById("dashboard-screen").classList.remove("hidden");
    buildSources(); render();
  } else {
    err.textContent = "Identifiant ou mot de passe incorrect";
    err.classList.remove("hidden");
  }
}

function doLogout() {
  document.getElementById("dashboard-screen").classList.add("hidden");
  document.getElementById("login-screen").classList.remove("hidden");
  document.getElementById("inp-user").value = "";
  document.getElementById("inp-pass").value = "";
}

function buildSources() {
  const row = document.getElementById("sources-row");
  row.innerHTML = SOURCES.map(s =>
    `<div class="source-pill${s==="Toutes"?" active":""}" onclick="setSource(this,'${s}')">${s}</div>`
  ).join("");
}

function setNiveau(el) {
  filtreNiveau = el.dataset.niv;
  document.querySelectorAll(".pill").forEach(p => p.className = "pill");
  const cls = filtreNiveau === "Tous" ? "active-tous" : "active-"+filtreNiveau;
  el.classList.add(cls);
  render();
}

function setSource(el, src) {
  filtreSource = src;
  document.querySelectorAll(".source-pill").forEach(p => p.classList.remove("active"));
  el.classList.add("active");
  render();
}

function marquerTousLus() { alertes.forEach(a => a.lu = true); render(); }

function render() {
  const rech = document.getElementById("search").value.toLowerCase();
  const filtrees = alertes.filter(a => {
    const ms = filtreSource === "Toutes" || a.source === filtreSource;
    const mn = filtreNiveau === "Tous" || a.niveau === filtreNiveau;
    const mr = !rech || a.titre.toLowerCase().includes(rech) || a.extrait.toLowerCase().includes(rech);
    return ms && mn && mr;
  });

  document.getElementById("stat-nonlus").textContent = alertes.filter(a => !a.lu).length;
  document.getElementById("stat-crit").textContent = alertes.filter(a => a.niveau === "critique").length;
  document.getElementById("stat-today").textContent = alertes.filter(a => a.date === TODAY).length;

  const list = document.getElementById("alertes-list");
  if (filtrees.length === 0) { list.innerHTML = '<div class="empty">Aucune alerte pour ces filtres.</div>'; return; }

  list.innerHTML = filtrees.map(a => {
    const niv = NIVEAUX[a.niveau];
    const isOpen = selected === a.id;
    return `
<div class="alerte${a.lu?" lu":""}" style="border-left-color:${niv.color};border-color:${isOpen?niv.border:"#d3d1c7"}" onclick="toggle(${a.id})">
  <div class="alerte-header">
    <div style="flex:1;padding-right:10px">
      <div class="alerte-meta">
        ${!a.lu?`<span class="dot-unread" style="background:${niv.color}"></span>`:""}
        <span class="alerte-date">${a.date} · ${a.heure} · ${a.source}</span>
      </div>
      <div class="alerte-titre">${a.titre}</div>
    </div>
    <span class="badge-niv" style="background:${niv.bg};color:${niv.color}">${niv.label}</span>
  </div>
  <div class="alerte-body${isOpen?" open":""}">
    <div class="extrait">"${a.extrait}"</div>
    <div class="alerte-actions">
      <a href="${a.url}" target="_blank" class="btn-link">Voir l'article →</a>
      <span class="btn-source">${a.source}</span>
    </div>
  </div>
</div>`;
  }).join("");

  document.getElementById("footer-txt").textContent =
    `${filtrees.length} alerte${filtrees.length>1?"s":""} · Prochaine veille dans moins d'1h · MaireWatch™ · CorreIA LLC`;
}

function toggle(id) {
  const a = alertes.find(x => x.id === id);
  if (a) a.lu = true;
  selected = selected === id ? null : id;
  render();
}
</script>
</body>
</html>
